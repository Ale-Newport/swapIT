{
  "name": "toolbox",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Toolbox \u2014 a fast, local-first desktop toolkit for everyday file tasks.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "rust:check": "cd src-tauri && cargo check",
    "rust:clippy": "cd src-tauri && cargo clippy --all-targets -- -D warnings",
    "rust:test": "cd src-tauri && cargo test",
    "check:all": "npm run typecheck && npm run lint && npm run test && npm run rust:clippy && npm run rust:test",
    "build:app": "tauri build --bundles app",
    "build:dmg": "npm run build:app && bash scripts/make-dmg.sh",
    "install:app": "npm run build:app && bash scripts/install-app.sh"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.3",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-fs": "^2.5.2",
    "@tauri-apps/plugin-notification": "^2.4.0",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "@tauri-apps/plugin-os": "^2.3.2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-store": "^2.4.4",
    "bwip-js": "^4.11.4",
    "clsx": "^2.1.1",
    "diff": "^9.0.0",
    "fast-xml-parser": "^5.11.1",
    "fuse.js": "^7.5.0",
    "js-yaml": "^4.1.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.544.0",
    "marked": "^15.0.7",
    "papaparse": "^5.5.3",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.3",
    "svgo": "^4.1.0",
    "turndown": "^7.2.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.2",
    "@types/papaparse": "^5.3.16",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/turndown": "^5.0.5",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.37.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.45.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
