# Toolbox needs no environment variables to build, run or test.
#
# The only optional ones are Apple's notarisation credentials. Without them the
# app is ad-hoc signed, which is enough for a build you install yourself (see
# README › About signing). Copy this file to `.env`, fill it in, and export it
# before `npm run build:app`. Never commit `.env` — it is git-ignored.
#
# In GitHub Actions, store these as repository secrets instead
# (Settings › Secrets and variables › Actions).

# Apple ID email used for notarisation
APPLE_ID=
# App-specific password from appleid.apple.com (not your Apple ID password)
APPLE_PASSWORD=
# 10-character Team ID from developer.apple.com
APPLE_TEAM_ID=
# Developer ID Application identity, e.g. "Developer ID Application: Name (TEAMID)"
APPLE_SIGNING_IDENTITY=

# Optional: expose the Vite dev server on your LAN for testing in another device's webview
# TAURI_DEV_HOST=
